<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Wireframe_1" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/yalaza_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/yalaza_bg</item>
        <item name="colorSurface">@color/yalaza_bg</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="Theme.Wireframe_1" parent="Base.Theme.Wireframe_1" />

    <style name="Yalaza.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="Yalaza.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Yalaza.LogoHero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Yalaza.Button.WhatsApp" parent="Widget.Material3.Button">
        <item name="android:text">@string/order_whatsapp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/whatsapp_green</item>
        <item name="cornerRadius">26dp</item>
        <item name="icon">@drawable/ic_whatsapp_white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Yalaza.Button.Instagram" parent="Widget.Material3.Button.OutlinedButton">
        <item name="icon">@drawable/ic_instagram_brand</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@null</item>
    </style>
</resources>
