<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:paddingHorizontal="12dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Yalaza.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/community_screen_title" />

        <TextView
            style="@style/Yalaza.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="@string/community_repost_intro" />

        <android.widget.GridLayout
            android:id="@+id/gridCommunity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCommunityUpload"
            style="@style/Yalaza.Button.Instagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="52dp"
            android:text="@string/community_upload_cta"
            android:textAllCaps="false"
            android:textColor="@color/wf_orange_nav"
            app:cornerRadius="22dp"
            app:strokeColor="@color/wf_orange_nav"
            app:strokeWidth="2dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
